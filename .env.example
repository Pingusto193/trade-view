# ---------------------------------------------------------------------------
# Radar — configuração. Copie este arquivo para ".env" e preencha.
# NUNCA publique o arquivo .env (ele já está no .gitignore).
# ---------------------------------------------------------------------------

# Ambiente: development (no seu computador) ou production (no servidor).
NODE_ENV=development

# Endereço e porta do servidor. Em produção, o Caddy fica na frente.
HOST=127.0.0.1
PORT=8787

# Arquivo do banco de dados (SQLite).
DATABASE_PATH=./data/radar.sqlite

# Endereço público do Radar (com https:// em produção). Usado nos links dos alertas.
PUBLIC_URL=http://localhost:5173

# Ligue (1) só quando o servidor estiver atrás de um proxy HTTPS (Caddy). Deixe 0 no computador.
TRUST_PROXY=0
# Limite geral de requisições por minuto por IP (padrão 600).
RATE_LIMIT_MAX=600
# Backup automático do banco (pasta data/backups): a cada N horas (0 = desligado), guardando os últimos K.
# Copie a pasta para fora do servidor de vez em quando: backup no mesmo disco não protege de perder o disco.
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=14
# Assistente com IA (opcional, desligado por padrão; a chave da API é informada na tela Conta).
# Modelo e preços em US$ por milhão de tokens (entrada/saída) conferidos em 14/10/2026 na página de
# preços da Anthropic (DATA_SOURCES §17). Confira de novo antes de usar: mudam com o tempo.
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_PRICE_IN=4
ASSISTANT_PRICE_OUT=20

# --- Somente desenvolvimento ---
# 1 = liga a fonte de DADOS SIMULADOS (proibido em produção; o servidor recusa iniciar).
RADAR_SIMULATED=0

# --- Fontes de dados (opcionais) ---
# Ações dos EUA — chaves da Alpaca (conta gratuita só de dados). Ver docs/DATA_SOURCES.md.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# B3 com atraso — token da brapi.dev (plano gratuito: ~30 min de atraso, 3 meses de histórico).
BRAPI_TOKEN=
# Forex pela internet (Twelve Data, ADR-0030): crie uma conta grátis em https://twelvedata.com e cole a
# chave. Plano grátis = 8 consultas por minuto e 800 por dia (o Radar conta e para antes de estourar).
# Vazio = forex só pelo MetaTrader 5 (agente no PC Windows).
TWELVE_DATA_KEY=
# TWELVE_DATA_PER_MINUTE=8
# TWELVE_DATA_PER_DAY=800

# Fundamentos dos EUA (lucro por ação e receita, da SEC EDGAR, gratuito). A SEC exige que o programa
# se identifique com um nome e um e-mail de contato. Ex.: SEC_USER_AGENT=Radar pessoal voce@exemplo.com
# Vazio = fundamentos dos EUA e notícias 8-K da SEC desligados. Os da B3 (CVM) não precisam de configuração.

# Notícias em tempo real (ADR-0032): ingestão contínua das fontes de DATA_SOURCES §19. 1 = desliga.
NEWS_DISABLED=0
SEC_USER_AGENT=

# ---------------------------------------------------------------- Alertas (Fase 4)
# E-mail: servidor SMTP do seu provedor (ex.: o "senha de app" do Gmail). Sem SMTP_HOST, sem e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Web Push: deixe vazio para o servidor gerar as chaves sozinho (arquivo vapid.json ao lado do banco).
# Se trocar as chaves, todos os aparelhos precisam ativar as notificações de novo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# ---------------------------------------------------------------- Publicação (Docker + Caddy)
# Domínio que aponta para o servidor (sem https://). O Caddy pede o certificado HTTPS sozinho.
RADAR_DOMAIN=
