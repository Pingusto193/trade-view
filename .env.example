# ---------------------------------------------------------------------------
# Radar — configuração. Copie este arquivo para ".env" e preencha.
# NUNCA publique o arquivo .env (ele já está no .gitignore).
# ---------------------------------------------------------------------------

# Ambiente: development (no seu computador) ou production (no servidor).
NODE_ENV=development

# Endereço e porta do servidor. Em produção, o Caddy fica na frente.
HOST=127.0.0.1
PORT=8787

# Arquivo do banco de dados (SQLite).
DATABASE_PATH=./data/radar.sqlite

# Endereço público do Radar (com https:// em produção). Usado nos links dos alertas.
PUBLIC_URL=http://localhost:5173

# Ligue (1) só quando o servidor estiver atrás de um proxy HTTPS (Caddy). Deixe 0 no computador.
TRUST_PROXY=0

# --- Somente desenvolvimento ---
# 1 = liga a fonte de DADOS SIMULADOS (proibido em produção; o servidor recusa iniciar).
RADAR_SIMULATED=0

# --- Fontes de dados (opcionais) ---
# Ações dos EUA — chaves da Alpaca (conta gratuita só de dados). Ver docs/DATA_SOURCES.md.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# B3 com atraso — token da brapi.dev (plano gratuito: ~30 min de atraso, 3 meses de histórico).
BRAPI_TOKEN=

# ---------------------------------------------------------------- Alertas (Fase 4)
# E-mail: servidor SMTP do seu provedor (ex.: o "senha de app" do Gmail). Sem SMTP_HOST, sem e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Web Push: deixe vazio para o servidor gerar as chaves sozinho (arquivo vapid.json ao lado do banco).
# Se trocar as chaves, todos os aparelhos precisam ativar as notificações de novo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# ---------------------------------------------------------------- Publicação (Docker + Caddy)
# Domínio que aponta para o servidor (sem https://). O Caddy pede o certificado HTTPS sozinho.
RADAR_DOMAIN=
