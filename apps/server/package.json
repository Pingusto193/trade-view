{
  "name": "@radar/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "import:cotahist": "tsx src/cli/import-cotahist.ts",
    "backup": "tsx src/cli/backup.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@node-rs/argon2": "^2.2.2",
    "@radar/core": "workspace:*",
    "@radar/data": "workspace:*",
    "@radar/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "nodemailer": "10.0.14",
    "tsx": "^4.23.15",
    "uqr": "^0.1.3",
    "web-push": "3.6.7",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/web-push": "3.6.4",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "ws": "^8.22.0"
  }
}
